<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tallyman</ToolCommandName>
    <PackageId>tallyman</PackageId>
    <Version>1.0.2</Version>
    <Description>Tallyman counts lines in every file under one or more directories.</Description>

    <Authors>Jaeymo</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>cli;lines;loc;line-count;tool</PackageTags>
    <PackageProjectUrl>https://github.com/jaeymo/tallyman</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jaeymo/tallyman</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Jaeymo</Copyright>
    <PackageReleaseNotes>Multi-directory support and table output.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
